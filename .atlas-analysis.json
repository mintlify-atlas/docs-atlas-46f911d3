  "keyFeatures": [
    "Create microVMs directly from OCI container images",
    "Minimal footprint with fast boot times",
    "Zero disk image maintenance — uses OCI image as rootfs",
    "Zero network configuration via Transparent Socket Impersonation (TSI)",
    "Host volume mapping into the guest microVM",
    "Guest port exposure to the host",
    "Cross-platform support: Linux/KVM (x86_64, AArch64) and macOS/Hypervisor.framework (ARM64)",
    "x86_64 microVM emulation on macOS AArch64 via Rosetta"
  ],
  "publicApiSurface": [
    "krunvm create <image> [--name] [--cpus] [--mem] [--dns] [--workdir] [--volume] [--port]",
    "krunvm start <name> [command] [args] [--env]",
    "krunvm list",
    "krunvm inspect <name>",
    "krunvm delete <name>",
    "krunvm changevm <name> [--new-name] [--cpus] [--mem] [--workdir] [--volume] [--port] [--remove-volumes] [--remove-ports]",
    "krunvm config [--cpus] [--mem] [--dns]"
  ]
